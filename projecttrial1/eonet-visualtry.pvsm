    <Proxy group="animation" type="PythonAnimationCue" id="17899" servers="16">
      <Property name="Enabled" id="17899.Enabled" number_of_elements="1">
        <Element index="0" value="1"/>
        <Domain name="bool" id="17899.Enabled.bool"/>
      </Property>
      <Property name="EndTime" id="17899.EndTime" number_of_elements="1">
        <Element index="0" value="1"/>
      </Property>
      <Property name="Script" id="17899.Script" number_of_elements="1">
        <Element index="0" value="from paraview.simple import *&#xa;from paraview import servermanager as sm&#xa;&#xa;WINDOW = 10 * 86400  # 10 days in seconds&#xa;T_MIN = None&#xa;T_MAX = None&#xa;&#xa;def _load_range():&#xa;    global T_MIN, T_MAX&#xa;    src = FindSource(&#x27;eonet_events.csv&#x27;)&#xa;    src.UpdatePipeline()&#xa;    table = sm.Fetch(src)                       # vtkTable&#xa;    T_MIN, T_MAX = table.GetColumnByName(&#x27;time&#x27;).GetRange()&#xa;&#xa;def start_cue(self):&#xa;    _load_range()&#xa;&#xa;def tick(self):&#xa;    if T_MIN is None:          # covers scrubbing before the first play&#xa;        _load_range()&#xa;&#xa;    span = self.GetEndTime() - self.GetStartTime()&#xa;    frac = (self.GetAnimationTime() - self.GetStartTime()) / span if span else 0.0&#xa;    t = T_MIN + frac * (T_MAX - T_MIN)&#xa;&#xa;&#xa;&#xa;&#xa;    thr = FindSource(&#x27;Threshold_time&#x27;)&#xa;    thr.LowerThreshold = max(T_MIN, t - WINDOW)&#xa;    thr.UpperThreshold = t&#xa;&#xa;def end_cue(self):&#xa;    pass"/>
      </Property>
      <Property name="StartTime" id="17899.StartTime" number_of_elements="1">
        <Element index="0" value="0"/>
      </Property>
      <Property name="TimeMode" id="17899.TimeMode" number_of_elements="1">
        <Element index="0" value="0"/>
        <Domain name="enum" id="17899.TimeMode.enum">
          <Entry value="0" text="Normalized"/>
          <Entry value="1" text="Relative"/>
        </Domain>
      </Property>
    </Proxy>
